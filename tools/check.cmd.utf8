@echo off
rem ============================================================
rem  NovaCode: проверка окружения на Windows XP
rem  Положите этот файл рядом с NovaCode.exe и запустите двойным
rem  щелчком. Отчёт печатается на экран и сохраняется в
rem  %TEMP%\NovaCode-check.txt (кодировка DOS, CP866).
rem ============================================================
chcp 866 >nul 2>&1
setlocal
set "LOG=%TEMP%\NovaCode-check.txt"
if /i "%~1"=="log" goto checks
title NovaCode: проверка окружения
call "%~f0" log > "%LOG%" 2>&1
type "%LOG%"
echo.
echo   Отчёт сохранён в файл:
echo   %LOG%
echo.
echo   Скопировать текст в буфер: правый клик по заголовку окна,
echo   "Правка" - "Выделить всё", затем Enter.
echo.
pause
exit /b 0

:checks
echo ================================================
echo    NovaCode: проверка окружения Windows XP
echo ================================================
echo.

echo [Система]
ver
echo   PROCESSOR_ARCHITECTURE=%PROCESSOR_ARCHITECTURE%
call :spver
echo   Папка скрипта: %~dp0
call :freespace
echo.

echo [Файлы NovaCode]
if exist "%~dp0NovaCode.exe" for %%F in ("%~dp0NovaCode.exe") do echo   NovaCode.exe: есть, %%~zF байт
if not exist "%~dp0NovaCode.exe" echo   NovaCode.exe: НЕ НАЙДЕН рядом со скриптом
if exist "%~dp0NovaCode.exe.config" echo   NovaCode.exe.config: есть
if not exist "%~dp0NovaCode.exe.config" echo   NovaCode.exe.config: НЕТ (CLR может не найти v4.0)
echo   Ожидаемый размер NovaCode.exe: 223744 байт
echo.

echo [.NET Framework 4.0]
if exist "%windir%\system32\mscoree.dll" echo   mscoree.dll: есть
if not exist "%windir%\system32\mscoree.dll" echo   mscoree.dll: НЕТ - .NET Framework не установлен вообще
if exist "%windir%\Microsoft.NET\Framework\v4.0.30319\clr.dll" echo   CLR v4.0.30319: есть
if not exist "%windir%\Microsoft.NET\Framework\v4.0.30319\clr.dll" echo   CLR v4.0.30319: НЕТ - нужен .NET Framework 4.0
if exist "%windir%\Microsoft.NET\Framework\v4.0.30319\System.Numerics.dll" echo   System.Numerics.dll: есть
if not exist "%windir%\Microsoft.NET\Framework\v4.0.30319\System.Numerics.dll" echo   System.Numerics.dll: НЕТ
echo.
echo   Версии в %windir%\Microsoft.NET\Framework:
dir /b /ad "%windir%\Microsoft.NET\Framework" 2>nul
set FWCOUNT=0
for /f %%C in ('dir /b /ad "%windir%\Microsoft.NET\Framework" 2^>nul ^| find /c /v ""') do set FWCOUNT=%%C
if "%FWCOUNT%"=="0" echo   (папка пуста - ни одной версии .NET не установлено)
echo.
echo   Реестр, полный профиль .NET 4.0:
call :regcheck "HKLM\SOFTWARE\Microsoft\NET Framework Setup\NDP\v4\Full" "полный .NET 4.0"
echo   Реестр, клиентский профиль .NET 4.0:
call :regcheck "HKLM\SOFTWARE\Microsoft\NET Framework Setup\NDP\v4\Client" "Client Profile"
echo.

echo [Установщик .NET 4.0 рядом со скриптом]
if exist "%~dp0dotNetFx40_Full_x86_x64.exe" for %%F in ("%~dp0dotNetFx40_Full_x86_x64.exe") do call :checksize %%~zF
if not exist "%~dp0dotNetFx40_Full_x86_x64.exe" echo   dotNetFx40_Full_x86_x64.exe: не найден
echo.

echo [Конфигурация NovaCode.exe.config]
if exist "%~dp0NovaCode.exe.config" find /i "supportedRuntime" "%~dp0NovaCode.exe.config" 2>nul
if not exist "%~dp0NovaCode.exe.config" echo   Файла нет.
echo.

echo [Итог]
if not exist "%windir%\Microsoft.NET\Framework\v4.0.30319\clr.dll" goto no_dotnet
if not exist "%windir%\Microsoft.NET\Framework\v4.0.30319\System.Numerics.dll" goto client_profile
echo   Полный .NET Framework 4.0 установлен.
echo   Если ошибка 0xc0000135 остаётся:
echo   1) переустановите .NET 4.0 поверх (dotNetFx40_Full_x86_x64.exe);
echo   2) проверьте, что NovaCode.exe.config лежит рядом с EXE;
echo   3) не запускайте EXE из ZIP или с сетевого диска - распакуйте
echo      архив в локальную папку, например C:\NovaCode.
goto done

:no_dotnet
echo   .NET Framework не установлен вообще (нет даже mscoree.dll).
echo   Код 0xc0000135 (STATUS_DLL_NOT_FOUND) для управляемого EXE
echo   означает ровно это: Windows не нашла CLR.
echo.
echo   Что делать:
echo   1) Убедитесь, что это Windows XP SP3 (см. пункт [Система] выше).
echo      На XP без SP3 .NET 4.0 не ставится - сначала нужен SP3.
echo   2) Скачайте на современном компьютере полный установщик:
echo      dotNetFx40_Full_x86_x64.exe, 50 449 456 байт
echo      https://download.microsoft.com/download/9/5/A/95A9616B-7A37-4AF6-BC36-D6EA96C8DAAE/dotNetFx40_Full_x86_x64.exe
echo      SHA-256: 65E064258F2E418816B304F646FF9E87AF101E4C9552AB064BB74D281C38659F
echo      Скачивать лучше не на XP: тамошний Internet Explorer знает
echo      только TLS 1.0, и сайт Microsoft может не открыться.
echo   3) Перенесите файл на XP (флешка, CD), положите в эту папку
echo      и запустите двойным щелчком. Нужны права администратора.
echo   4) После установки перезагрузитесь и запустите check.cmd снова:
echo      должно появиться "Полный .NET Framework 4.0 установлен".
echo   Client Profile не подходит: в нём нет System.Numerics.dll.
goto done

:client_profile
echo   Установлен только клиентский профиль .NET 4.0.
echo   Нужен полный .NET Framework 4.0 (Full), не Client Profile:
echo   NovaCode использует System.Numerics.dll.
echo   Установщик: dotNetFx40_Full_x86_x64.exe (50 449 456 байт).
goto done

:done
echo.
exit /b 0

:spver
reg query "HKLM\SOFTWARE\Microsoft\Windows NT\CurrentVersion" /v CSDVersion >nul 2>&1
if errorlevel 1 goto nosp
for /f "tokens=3*" %%A in ('reg query "HKLM\SOFTWARE\Microsoft\Windows NT\CurrentVersion" /v CSDVersion 2^>nul ^| find /i "CSDVersion"') do echo   Версия: %%A %%B
exit /b 0
:nosp
echo   Версия: Service Pack не установлен (нужен SP3)
exit /b 0

:freespace
fsutil volume diskfree %SystemDrive% > "%TEMP%\NovaCode-check.fs" 2>nul
if errorlevel 1 goto nofs
type "%TEMP%\NovaCode-check.fs"
del "%TEMP%\NovaCode-check.fs" >nul 2>&1
exit /b 0
:nofs
del "%TEMP%\NovaCode-check.fs" >nul 2>&1
echo   Свободное место: не удалось определить (нужны права администратора)
exit /b 0

:checksize
if "%~1"=="50449456" echo   dotNetFx40_Full_x86_x64.exe: есть, %~1 байт - размер верный
if not "%~1"=="50449456" echo   dotNetFx40_Full_x86_x64.exe: есть, %~1 байт - ВНИМАНИЕ, ожидалось 50449456
exit /b 0

:regcheck
reg query %1 /v Install >nul 2>&1
if errorlevel 1 (echo   %~2: ключ не найден) else (echo   %~2: установлен)
exit /b 0
