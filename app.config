<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <startup>
    <!-- .NET Framework 4.0 — последняя версия, работающая на Windows XP SP3 -->
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.0" />
  </startup>
  <runtime>
    <loadFromRemoteSources enabled="false" />
  </runtime>
</configuration>
